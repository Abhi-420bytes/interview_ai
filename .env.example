# Anthropic credentials. Without either of these the engine runs in offline
# mode: template question bank + heuristic scoring, no network calls.
ANTHROPIC_API_KEY=

# Optional: lifts the GitHub public API rate limit from 60/hr to 5000/hr.
INTERVIEW_GITHUB_TOKEN=

# Model split. The fast model is on the latency-critical path.
INTERVIEW_FAST_MODEL=claude-haiku-4-5
INTERVIEW_DEEP_MODEL=claude-opus-5

# Latency budgets in seconds. Past these the heuristic verdict is used.
INTERVIEW_EVAL_BUDGET_S=1.6
INTERVIEW_FOLLOWUP_BUDGET_S=1.2

# Session shape.
INTERVIEW_SESSION_LENGTH=12
INTERVIEW_WARMUP_QUESTIONS=3

# Force heuristic-only operation even with credentials present.
INTERVIEW_OFFLINE=false
